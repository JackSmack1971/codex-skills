{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skilltelemetry.finding.v1",
  "title": "Skill Telemetry Finding v1",
  "type": "object",
  "required": ["schema", "finding_id", "finding_type", "status", "confidence", "support_count", "run_ids", "observation", "proposed_change_class"],
  "properties": {
    "schema": {"const": "skilltelemetry.finding.v1"},
    "finding_id": {"type": "string"},
    "finding_type": {"type": "string"},
    "status": {"enum": ["candidate", "supported", "promoted", "dismissed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "support_count": {"type": "integer", "minimum": 1},
    "run_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observation": {"type": "string"},
    "effect": {"type": ["string", "null"]},
    "hypothesis": {"type": ["string", "null"]},
    "proposed_change_class": {"enum": ["instruction", "script", "schema", "runtime_check", "eval", "observability", "none"]},
    "requires_review": {"type": "boolean"}
  },
  "additionalProperties": true
}
