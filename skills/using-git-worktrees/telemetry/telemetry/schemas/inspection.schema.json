{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skilltelemetry.inspection.v1",
  "title": "Static Skill Inspection v1",
  "type": "object",
  "required": ["schema", "target", "inventory", "candidates", "fingerprint"],
  "properties": {
    "schema": {"const": "skilltelemetry.inspection.v1"},
    "target": {"type": "object"},
    "fingerprint": {"type": "string"},
    "inventory": {"type": "array"},
    "candidates": {
      "type": "object",
      "required": ["decisions", "boundaries", "verification", "execution", "privacy"]
    }
  },
  "additionalProperties": true
}
