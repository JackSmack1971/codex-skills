{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skilltelemetry.eval-candidate.v1",
  "title": "Skill Telemetry Eval Candidate v1",
  "type": "object",
  "required": ["schema", "eval_id", "source_finding_id", "title", "kind", "expected_behavior", "promotion_status", "requires_review"],
  "properties": {
    "schema": {"const": "skilltelemetry.eval-candidate.v1"},
    "eval_id": {"type": "string"},
    "source_finding_id": {"type": "string"},
    "title": {"type": "string"},
    "kind": {"enum": ["deterministic", "rubric", "hybrid"]},
    "expected_behavior": {"type": "string"},
    "check": {"type": "object"},
    "promotion_status": {"const": "candidate"},
    "requires_review": {"const": true}
  },
  "additionalProperties": true
}
