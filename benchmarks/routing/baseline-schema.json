{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routing-baseline",
  "title": "Metadata-only routing baseline",
  "type": "object",
  "required": ["schema_version", "kind", "artifact_policy", "metadata", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "routing-baseline"},
    "artifact_policy": {"type": "string", "pattern": "metadata-only"},
    "metadata": {"type": "object", "required": ["runtime_versions", "codex_versions", "case_count", "trial_count"]},
    "cases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trial_count", "trials"],
        "properties": {
          "trial_count": {"type": "integer", "minimum": 0},
          "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "trial": {
      "type": "object",
      "required": ["case_id", "trial_id", "run_id", "captured_at_utc", "runtime_version", "codex_version", "git_commit"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "trial_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "captured_at_utc": {"type": "string", "minLength": 1},
        "runtime_version": {"type": ["string", "null"]},
        "codex_version": {"type": ["string", "null"]},
        "git_commit": {"type": ["string", "null"]}
      }
    }
  }
}
